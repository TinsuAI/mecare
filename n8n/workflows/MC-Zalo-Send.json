      },
      "id": "update-messages-sent",
      "name": "Update Messages Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r4",
              "name": "result",
              "value": "sent",
              "type": "string"
            },
            {
              "id": "r5",
              "name": "message_id",
              "value": "={{ $('Trigger').first().json.message_id }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "return-sent",
      "name": "Return: Sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        1200,
        120
      ]
    }
