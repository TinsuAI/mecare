                "jsCode": "// Inline from n8n/lib/schedule-utils.js\nfunction nextDueAt(dueAtIso, cadenceType) {\n  const offsets = { weekly: 7, monthly: 30, quarterly: 90 };\n  const days = offsets[cadenceType];\n  if (!days) return null;\n  return new Date(Date.parse(dueAtIso) + days * 86400000).toISOString();\n}\n\nfunction addMinutes(isoStr, minutes) {\n  return new Date(Date.parse(isoStr) + minutes * 60000).toISOString();\n}\n\nconst row = $('Process Each Row').first().json;\nconst cadenceType = row.cadence_type;\nconst nextDue = nextDueAt(row.due_at, cadenceType);\nconst create_next = nextDue !== null;\nconst sent_at = new Date().toISOString();\nconst follow_up_due_at = addMinutes(sent_at, 90);\nreturn [{ json: { ...row, create_next, next_due_at: nextDue, sent_at, follow_up_due_at } }];"
            },
