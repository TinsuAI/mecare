    {
      "parameters": {
        "jsCode": "const faqResult = $('Call OpenClaw FAQ').first().json;\nconst answer = String(faqResult.answer ?? '');\nconst isTpcn = Boolean(faqResult.is_tpcn);\nconst mandatorySuffix = (isTpcn && faqResult.mandatory_suffix) ? faqResult.mandatory_suffix : null;\nconst finalAnswer = mandatorySuffix ? `${answer}\\n\\n${mandatorySuffix}` : answer;\nreturn [{ json: {\n  final_answer: finalAnswer,\n  is_tpcn: isTpcn,\n  scope: faqResult.scope ?? '',\n  customer_id: $('Classify Response').first().json.customer_id,\n  pharmacy_id: $('Classify Response').first().json.pharmacy_id\n}}];"
      },
