      "id": "log-inbound-message",
      "name": "Log Inbound Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [240, 240]
    },
    {
      "parameters": {
        "jsCode": "const content = ($('Webhook Trigger').first().json.body.message_content ?? '').trim().toLowerCase();\nconst care_group = $('Webhook Trigger').first().json.body.care_group;\nconst customer_id = $('Webhook Trigger').first().json.body.customer_id;\nconst pharmacy_id = $('Webhook Trigger').first().json.body.pharmacy_id;\nconst OPT_OUT_KW = ['dừng', 'thôi', 'không nhắn nữa', 'stop', 'hủy', 'bỏ đi', 'không cần', 'thôi nhắn'];\nconst is_opt_out = OPT_OUT_KW.some(kw => content.includes(kw));\nconst is_done_signal = !is_opt_out && (/^1[\\s\\b.,]?/.test(content) || ['đỡ rồi','xong rồi','done'].some(kw => content.includes(kw)));\nconst is_continue_signal = !is_opt_out && !is_done_signal && (/^2[\\s\\b.,]?/.test(content) || content.includes('chưa đỡ'));\nconst is_escalation = !is_opt_out && !is_done_signal && !is_continue_signal && (/^3[\\s\\b.,]?/.test(content) || ['nặng hơn','tệ hơn'].some(kw => content.includes(kw)));\nconst classified_type = is_opt_out ? 'opt_out' : is_done_signal ? 'done_signal' : is_continue_signal ? 'continue_signal' : is_escalation ? 'escalation_trigger' : 'free_form';\nreturn [{ json: { pharmacy_id, customer_id, care_group, message_content: content, classified_type, is_opt_out, is_done_signal, is_escalation } }];"
      },
      "id": "classify-response",
      "name": "Classify Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.care_group }}",
              "rightValue": 6,
              "operator": { "type": "number", "operation": "equal" }
            }
          ]
        }
      },
