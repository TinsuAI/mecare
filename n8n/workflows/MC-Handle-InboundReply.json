      "name": "Guard: Is Opt-Out",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 240]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.BASEROW_URL }}/api/database/rows/table/{{ $env.BASEROW_TABLE_CUSTOMERS }}/{{ $json.customer_id }}/?user_field_names=true",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Token {{ $env.BASEROW_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "is_opted_out": true
        }
      },
      "id": "update-customer-opted-out",
      "name": "Update Customer Opted Out",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1440, 120]
    },
    {
      "parameters": {
        "jsCode": "const customerId = $json.customer_id;\nconst pharmacyId = $json.pharmacy_id;\nconst baserowUrl = $env.BASEROW_URL;\nconst token = $env.BASEROW_TOKEN;\nconst table = $env.BASEROW_TABLE_CARE_SCHEDULE;\nconst statuses = ['pending', 'rate_limited'];\nlet cancelledCount = 0;\nfor (const status of statuses) {\n  const res = await $http.get(`${baserowUrl}/api/database/rows/table/${table}/?filter__field_customer_id__link_row_has=${customerId}&filter__field_status__equal=${status}&user_field_names=true`);\n  const rows = res.body?.results ?? [];\n  for (const row of rows) {\n    await $http.patch(`${baserowUrl}/api/database/rows/table/${table}/${row.id}/?user_field_names=true`, { body: { status: 'skipped' }, headers: { Authorization: `Token ${token}` } });\n    cancelledCount++;\n  }\n}\nreturn [{ json: { ...$input.first().json, cancelled_count: cancelledCount, actions: ['opted_out', 'schedule_cleared'] } }];"
      },
      "id": "cancel-pending-schedule",
      "name": "Cancel Pending Schedule",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.classified_type }}",
              "rightValue": "done_signal",
              "operator": { "type": "string", "operation": "equal" }
            }
          ]
        }
      },
      "id": "guard-is-done-signal",
      "name": "Guard: Is Done Signal",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1440, 360]
    },
    {
      "parameters": {
        "jsCode": "const customerId = $json.customer_id;\nconst baserowUrl = $env.BASEROW_URL;\nconst token = $env.BASEROW_TOKEN;\nconst table = $env.BASEROW_TABLE_CARE_SCHEDULE;\nconst res = await $http.get(`${baserowUrl}/api/database/rows/table/${table}/?filter__field_customer_id__link_row_has=${customerId}&filter__field_status__equal=pending&user_field_names=true`);\nconst rows = res.body?.results ?? [];\nfor (const row of rows) {\n  await $http.patch(`${baserowUrl}/api/database/rows/table/${table}/${row.id}/?user_field_names=true`, { body: { status: 'done' }, headers: { Authorization: `Token ${token}` } });\n}\nreturn [{ json: { ...$input.first().json, closed_count: rows.length, actions: ['messages_logged', 'schedule_closed'] } }];"
      },
      "id": "cancel-followup-schedule",
      "name": "Cancel Follow-Up Schedule",
