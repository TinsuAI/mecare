    {
      "parameters": {
        "jsCode": "const messageId = $('Audit: Write Messages Pending').first().json.id;\nconst sendResult = $('Execute MC-Zalo-Send').first().json;\nconst status = (sendResult && !sendResult.error) ? 'sent' : 'failed';\nconst baserowUrl = $env.BASEROW_URL;\nconst token = $env.BASEROW_TOKEN;\nconst table = $env.BASEROW_TABLE_MESSAGES;\ntry {\n  await $http.patch(\n    `${baserowUrl}/api/database/rows/table/${table}/${messageId}/?user_field_names=true`,\n    { body: { status }, headers: { Authorization: `Token ${token}` } }\n  );\n} catch (e) {\n  console.error('[MC-Handle-InboundReply] Update Messages Status failed:', e.message);\n}\nconst classifyData = $('Classify Response').first().json;\nreturn [{ json: {\n  classified_type: classifyData.classified_type,\n  pharmacy_id: classifyData.pharmacy_id,\n  customer_id: classifyData.customer_id,\n  message_id: messageId,\n  status,\n  actions: ['faq_answered']\n}}];"
      },
      "id": "update-messages-status",
      "name": "Update Messages Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = ($('Classify Response').first().json.message_content ?? '').toLowerCase();\nconst classified_type = $('Classify Response').first().json.classified_type ?? '';\nconst is_complaint_active = $('Webhook Trigger').first().json.body.is_complaint_active ?? false;\n\n// Priority 1: is_complaint_active flag (cờ cắt ngang Nhóm 5)\nif (is_complaint_active === true || is_complaint_active === 'true') {\n  return [{ json: { trigger_type: 'complaint_serious', trigger_excerpt: '[is_complaint_active=true]', is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 2: emergency keywords (tập con của adverse_reaction/otc_red_flag)\nconst EMERGENCY_KW = ['khó thở', 'sưng mặt', 'sưng lưỡi', 'mẩn đỏ lan', 'sốc phản vệ', 'ngất', 'co giật'];\nfor (const kw of EMERGENCY_KW) {\n  if (msg.includes(kw)) {\n    return [{ json: { trigger_type: 'emergency', trigger_excerpt: kw, is_emergency: true, needs_escalation: true } }];\n  }\n}\nif (msg.includes('đau tức ngực') && msg.includes('khó thở')) {\n  return [{ json: { trigger_type: 'emergency', trigger_excerpt: 'đau tức ngực + khó thở', is_emergency: true, needs_escalation: true } }];\n}\n\n// Priority 3: adverse_reaction\nconst ADVERSE_KW = ['dị ứng', 'ngứa', 'nổi mẩn', 'phát ban', 'tác dụng phụ', 'phản ứng thuốc'];\nfor (const kw of ADVERSE_KW) {\n  if (msg.includes(kw)) return [{ json: { trigger_type: 'adverse_reaction', trigger_excerpt: kw, is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 4: out_of_range_vitals (HA, đường huyết)\nconst VITALS_KW = ['huyết áp', 'mmhg', 'đường huyết', 'mmol', 'chỉ số vượt'];\nfor (const kw of VITALS_KW) {\n  if (msg.includes(kw)) return [{ json: { trigger_type: 'out_of_range_vitals', trigger_excerpt: kw, is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 5: otc_red_flag\nconst OTC_RED_KW = ['sốt không hạ', 'sốt mấy ngày', 'sốt 3 ngày', 'nôn nhiều lần', 'tiêu chảy liên tục'];\nfor (const kw of OTC_RED_KW) {\n  if (msg.includes(kw)) return [{ json: { trigger_type: 'otc_red_flag', trigger_excerpt: kw, is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 6: otc_no_improvement\nconst NO_IMP_KW = ['uống hết thuốc không đỡ', 'uống xong vẫn', 'không cải thiện', 'không khỏi', 'uống đủ mà vẫn'];\nfor (const kw of NO_IMP_KW) {\n  if (msg.includes(kw)) return [{ json: { trigger_type: 'otc_no_improvement', trigger_excerpt: kw, is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 7: medication_change\nconst MED_KW = ['đổi thuốc', 'xin đổi', 'đơn thuốc', 'thay thuốc', 'bác sĩ kê'];\nfor (const kw of MED_KW) {\n  if (msg.includes(kw)) return [{ json: { trigger_type: 'medication_change', trigger_excerpt: kw, is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 8: drug_interaction\nconst DRUG_KW = ['tương tác thuốc', 'chống chỉ định', 'uống cùng lúc', 'kết hợp thuốc', 'phối hợp thuốc'];\nfor (const kw of DRUG_KW) {\n  if (msg.includes(kw)) return [{ json: { trigger_type: 'drug_interaction', trigger_excerpt: kw, is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 9: complaint_serious keywords (không có cờ is_complaint_active)\nconst COMPLAINT_KW = ['khiếu nại', 'tố cáo', 'bồi thường', 'thuốc giả', 'phản ánh'];\nfor (const kw of COMPLAINT_KW) {\n  if (msg.includes(kw)) return [{ json: { trigger_type: 'complaint_serious', trigger_excerpt: kw, is_emergency: false, needs_escalation: true } }];\n}\n\n// Priority 10: ai_uncertainty catch-all (free_form không match / can_answer=false từ FAQ)\nreturn [{ json: { trigger_type: 'ai_uncertainty', trigger_excerpt: '', is_emergency: false, needs_escalation: true } }];"
      },
      "id": "detect-escalation-trigger",
      "name": "Detect Escalation Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        360
