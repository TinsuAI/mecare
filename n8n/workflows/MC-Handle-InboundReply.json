        "jsCode": "const customerId = $json.customer_id ?? $('Classify Response').first().json.customer_id;\nconst baserowUrl = $env.BASEROW_URL;\nconst token = $env.BASEROW_TOKEN;\nconst table = $env.BASEROW_TABLE_CARE_SCHEDULE;\nconst authHeader = { Authorization: `Token ${token}` };\nconst statuses = ['pending', 'rate_limited'];\nlet closedCount = 0;\nfor (const status of statuses) {\n  const res = await $http.get(`${baserowUrl}/api/database/rows/table/${table}/?filter__field_customer_id__link_row_has=${customerId}&filter__field_status__equal=${status}&user_field_names=true`, { headers: authHeader });\n  const rows = res.body?.results ?? [];\n  for (const row of rows) {\n    await $http.patch(`${baserowUrl}/api/database/rows/table/${table}/${row.id}/?user_field_names=true`, { body: { status: 'done' }, headers: authHeader });\n    closedCount++;\n  }\n}\nreturn [{ json: { ...$input.first().json, closed_count: closedCount, actions: ['messages_logged', 'schedule_closed'] } }];"
      },
