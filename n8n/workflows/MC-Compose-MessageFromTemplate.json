    {
      "parameters": {
        "jsCode": "// Inline from n8n/lib/compose-message.js\nfunction appendTpcnSuffix(content, careGroup) {\n  if (careGroup === 4) {\n    return content + '\\n\\nLưu ý: thực phẩm bảo vệ sức khỏe, không phải thuốc điều trị bệnh.';\n  }\n  return content;\n}\n\nconst { content, care_group } = $input.first().json;\nconst composed_content = appendTpcnSuffix(content, Number(care_group));\nreturn [{ json: { composed_content, care_group } }];"
      },
      "id": "append-tpcn-suffix",
      "name": "Append TPCN Suffix",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Inline from n8n/lib/compose-message.js\nconst crypto = require('crypto');\nfunction buildCustomerRef(pharmacyId, customerId) {\n  return crypto.createHash('sha256').update(pharmacyId + ':' + customerId).digest('hex');\n}\n\nconst { pharmacy_id, customer_id, message_id } = $('Trigger').first().json;\nconst { composed_content, care_group } = $input.first().json;\nconst customer_ref = buildCustomerRef(pharmacy_id, customer_id);\nconst care_group_int = Number(care_group);\nconst jsonBody = JSON.stringify({\n  pharmacy_id,\n  customer_ref,\n  message_id,\n  care_group: care_group_int,\n  type: 'proactive',\n  content: composed_content,\n  status: 'pending',\n  ts: new Date().toISOString()\n});\nreturn [{ json: { composed_content, care_group: care_group_int, customer_ref, message_id, pharmacy_id, jsonBody } }];"
      },
