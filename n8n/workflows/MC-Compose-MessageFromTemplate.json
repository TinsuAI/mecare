    {
      "parameters": {
        "jsCode": "// Inline from n8n/lib/compose-message.js (n8n cannot import local modules)\nfunction detectMissingPlaceholders(bodyTemplate, placeholderMap) {\n  const seen = [];\n  const re = /\\[([^\\]]+)\\]/g;\n  let match;\n  while ((match = re.exec(bodyTemplate)) !== null) {\n    const key = match[1];\n    if (!seen.includes(key)) seen.push(key);\n  }\n  return seen.filter((key) => !placeholderMap[key]);\n}\n\nfunction substituteTemplate(bodyTemplate, placeholderMap) {\n  const missing = detectMissingPlaceholders(bodyTemplate, placeholderMap);\n  if (missing.length > 0) return { ok: false, missing };\n  const content = bodyTemplate.replace(/\\[([^\\]]+)\\]/g, (_, key) => placeholderMap[key] ?? '');\n  return { ok: true, content };\n}\n\nconst triggerData = $('Trigger').first().json;\nconst templateRow = $('Fetch Template').first().json.results[0];\nconst customerRow = $('Fetch Customer').first().json;\nconst care_group = triggerData.care_group;\nconst bodyTemplate = templateRow.body_template;\n\nconst placeholderMap = {\n  'TÊN': customerRow.full_name || '',\n  'TÊN THUỐC': customerRow.notes || '',\n  'NGÀY TÁI KHÁM': triggerData.due_at || '',\n};\n\nconst result = substituteTemplate(bodyTemplate, placeholderMap);\nreturn [{ json: { ...result, care_group } }];"
      },
      "id": "resolve-placeholders",
      "name": "Resolve Placeholders",
      "type": "n8n-nodes-base.code",
