        "bodyParameters": {
          "parameters": [
            {
              "name": "pharmacy_id",
              "value": "={{ $json.pharmacy_id }}"
            },
            {
              "name": "entries",
              "value": "={{ $json.entries }}"
            }
          ]
        },
        "options": {}
      },
      "id": "post-reindex-openclaw",
