            {
              "name": "Authorization",
              "value": "Token {{ $env.BASEROW_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-approved-faqs",
      "name": "Fetch Approved FAQs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        240,
        240
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const results = $json.results ?? [];\nreturn results.map(r => ({ json: r }));"
      },
      "id": "expand-results",
      "name": "Expand Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "batchSize": 100,
        "options": {}
      },
      "id": "split-in-batches",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst entries = items.map(i => i.json);\nconst pharmacyId = $('Webhook Trigger').first().json.body.pharmacy_id\n  ?? $('Webhook Trigger').first().json.body.row?.pharmacy_id\n  ?? (entries[0]?.pharmacy_id ? (Array.isArray(entries[0].pharmacy_id) ? entries[0].pharmacy_id[0]?.id : entries[0].pharmacy_id) : null);\nreturn [{ json: { pharmacy_id: String(pharmacyId ?? ''), entries } }];"
      },
      "id": "collect-batch",
      "name": "Collect Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        240
      ]
    },
    {
