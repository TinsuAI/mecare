# ─────────────────────────────────────────────────────────────
# MeCare — Biến môi trường CHUNG (toàn stack)
# ─────────────────────────────────────────────────────────────
# Copy -> `.env` và điền giá trị thật. KHÔNG commit `.env`.
# Đây chỉ là PLACEHOLDER — KHÔNG đặt giá trị/khóa thật vào file này.
# Cấu hình per-tenant (Zalo session, quota) -> xem tenants/_template.env.
#
# PORT GUIDE:
#   HOST ports (an toàn đổi — Cloudflare tunnel trỏ vào đây):
#     BASEROW_HTTP_PORT=8001  ->  mecareapp.tinsu.ai
#     N8N_HTTP_PORT=8002      ->  mecareapp-n8n.tinsu.ai
#     ZALO_BRIDGE_HOST_PORT=8003  ->  mecareapp-webhook.tinsu.ai
#   NỘI BỘ ports (KHÔNG đổi — hardcode trong healthcheck compose):
#     N8N_PORT=5678           (n8n listen port, cố định)
#     ZALO_BRIDGE_PORT=3000   (zalo-bridge listen port, cố định)

# ── PostgreSQL (engine chung cho n8n + baserow) ──
POSTGRES_USER=mecare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mecare
# DB/schema riêng (compose tạo lúc init)
POSTGRES_BASEROW_DB=baserow
POSTGRES_N8N_DB=n8n

# ── OpenRouter / DeepSeek V4 Flash (egress cloud duy nhất, pin non-TQ) ──
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat-v4-flash

# ── Baserow ──
BASEROW_PUBLIC_URL=https://mecareapp.tinsu.ai
BASEROW_SECRET_KEY=change-me-baserow-secret
# HOST port (Cloudflare tunnel: mecareapp.tinsu.ai -> localhost:8001)
BASEROW_HTTP_PORT=8001
# ── Baserow REST API (Story 1.2 — áp schema/seed) ──
BASEROW_API_URL=https://mecareapp.tinsu.ai
BASEROW_DATABASE_NAME=MeCare
BASEROW_EMAIL=you@example.com
BASEROW_PASSWORD=change-me-baserow-login
BASEROW_API_TOKEN=your-baserow-database-token-here

# ── n8n (2.0) ──
N8N_HOST=mecareapp-n8n.tinsu.ai
# NỘI BỘ container — KHÔNG đổi (healthcheck hardcode localhost:5678)
N8N_PORT=5678
# HOST port (Cloudflare tunnel: mecareapp-n8n.tinsu.ai -> localhost:8002)
N8N_HTTP_PORT=8002
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_EXECUTIONS_MODE=regular
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
# Baserow table IDs dùng bởi n8n workflows
BASEROW_TABLE_MESSAGE_TEMPLATES=  # Baserow table ID for MessageTemplates — dùng bởi n8n workflow 4.1
BASEROW_TABLE_MESSAGES=           # Baserow table ID for Messages — dùng bởi n8n workflow 4.1 audit-first write
BASEROW_TABLE_CUSTOMERS=          # Baserow table ID for Customers — dùng bởi n8n workflow 4.1 fetch customer

# ── OpenClaw ──
OPENCLAW_MEMORY_PATH=/data/memory/mecare.db

# ── zalo-bridge ──
# NỘI BỘ container — KHÔNG đổi (healthcheck hardcode localhost:3000)
ZALO_BRIDGE_PORT=3000
# HOST port (Cloudflare tunnel: mecareapp-webhook.tinsu.ai -> localhost:8003)
ZALO_BRIDGE_HOST_PORT=8003
# Baserow API (opt-in gate — Story 2.1; also used by n8n workflows 4.x via $env.BASEROW_TOKEN)
BASEROW_TOKEN=your-baserow-database-token-here
BASEROW_URL=http://baserow:80
CUSTOMERS_TABLE_ID=
MESSAGES_TABLE_ID=
OPENZCA_URL=
# Anti-ban throttle (Story 2.2)
DAILY_SEND_CAP=50
WARMUP_DAILY_CAP=5
WARMUP_UNTIL_EPOCH_MS=
JITTER_MIN_MS=800
JITTER_MAX_MS=3000
BUSINESS_HOUR_START=7
BUSINESS_HOUR_END=21
# Risk monitor — auto-throttle on risk signals (Story 2.3)
RISK_BLOCK_COUNT_THRESHOLD=3
RISK_ERROR_COUNT_THRESHOLD=5
RISK_WINDOW_MINUTES=60
RISK_AUTO_RESUME=false
ALERT_WEBHOOK_URL=
SESSION_HEALTH_INTERVAL_MS=60000   # ms; poll interval for openzca health check; lower in dev for faster detection
