# ─────────────────────────────────────────────────────────────
# MeCare — Biến môi trường CHUNG (toàn stack)
# ─────────────────────────────────────────────────────────────
# Copy -> `.env` và điền giá trị thật. KHÔNG commit `.env`.
# Đây chỉ là PLACEHOLDER — KHÔNG đặt giá trị/khóa thật vào file này.
# Cấu hình per-tenant (Zalo session, quota) -> xem tenants/_template.env.

# ── PostgreSQL (engine chung cho n8n + baserow) ──
POSTGRES_USER=mecare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mecare
# DB/schema riêng (compose tạo lúc init)
POSTGRES_BASEROW_DB=baserow
POSTGRES_N8N_DB=n8n

# ── OpenRouter / DeepSeek V4 Flash (egress cloud duy nhất, pin non-TQ) ──
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat-v4-flash

# ── Baserow ──
BASEROW_PUBLIC_URL=http://localhost:8080
BASEROW_SECRET_KEY=change-me-baserow-secret
# Host port map cho UI Baserow (đổi nếu 8080 đã bận)
BASEROW_HTTP_PORT=8080
# Tên DB Baserow trong engine postgres chung — compose dùng POSTGRES_BASEROW_DB (ở trên).
# (DATABASE_NAME không được compose đọc; giữ để tham chiếu khi chạy baserow standalone.)
# ── Baserow REST API (Story 1.2 — áp schema/seed) ──
# scripts/apply-baserow-schema.mjs đọc các biến dưới. KHÔNG commit giá trị thật.
BASEROW_API_URL=http://localhost:8080
# Tên database (application) Baserow chứa schema MeCare
BASEROW_DATABASE_NAME=MeCare
# Auth tạo schema (bảng/field) CẦN JWT user — đặt email/password tài khoản Baserow:
BASEROW_EMAIL=you@example.com
BASEROW_PASSWORD=change-me-baserow-login
# Database Token (chỉ đủ quyền row CRUD/seed, KHÔNG tạo schema) — tùy chọn:
BASEROW_API_TOKEN=your-baserow-database-token-here

# ── n8n (2.0) ──
N8N_HOST=localhost
N8N_PORT=5678
# Host port map cho UI n8n (đổi nếu 5678 đã bận)
N8N_HTTP_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# Queue mode (tùy chọn v1) — compose map -> EXECUTIONS_MODE của n8n
N8N_EXECUTIONS_MODE=regular
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# ── OpenClaw ──
# Đường dẫn volume memory store (SQLite + sqlite-vec) — self-host
OPENCLAW_MEMORY_PATH=/data/memory/mecare.db

# ── zalo-bridge ──
ZALO_BRIDGE_PORT=3000
