# ─────────────────────────────────────────────────────────────
# MeCare — Template cấu hình per-tenant (per-nhà thuốc)
# ─────────────────────────────────────────────────────────────
# QUAN TRỌNG: KHÔNG commit file thật `tenants/<slug>.env`.
# Copy file này -> `tenants/<slug>.env` (vd `tenants/tructam.env`),
# điền giá trị thật. Chỉ `_template.env` (placeholder) được commit.
#
# Tenant đầu tiên thực tế = Trúc Tâm (tructam.env) — tạo ở bước onboarding,
# KHÔNG ở story 1.1.

# Slug nhà thuốc — dùng trong mã ca: ESC-<PHARMACY_SLUG>-...
PHARMACY_SLUG=tructam

# Persona AI relay (xem memory mecare-persona-relay) — Dược Sĩ Hải, KHÔNG phải "Ngọc"
PERSONA_NAME=Dược Sĩ Hải

# ── Phiên Zalo (openzca) — zalo-bridge cô lập per-tenant ──
# Đường dẫn thư mục lưu phiên openzca cho tenant này
ZALO_SESSION_DIR=/data/zalo-sessions/tructam
# Tham chiếu phiên / cookie ref (KHÔNG commit giá trị thật)
ZALO_SESSION_REF=

# ── Quota & giờ làm việc ──
# Trần gói: 1.000 tin/tháng
MONTHLY_MESSAGE_QUOTA=1000
# Giờ làm việc (24h, giờ VN) — watchdog/scheduler dùng để giới hạn gửi chủ động
WORKING_HOURS_START=08:00
WORKING_HOURS_END=21:00

# ── Liên kết Baserow (CRM nguồn sự thật cho tenant) ──
# ID workspace/database Baserow của tenant (điền sau khi tạo schema — Story 1.2)
BASEROW_TENANT_DB_ID=
# Database Token Baserow per-tenant (nếu tách token theo nhà thuốc) — KHÔNG commit giá trị thật
BASEROW_API_TOKEN=

# ── Leo thang & relay dược sĩ (Story 5.3) ──
# Zalo ID (số điện thoại) dược sĩ thật nhận ca relay — bắt buộc để relay hoạt động
PHARMACIST_ZALO_ID=
# Ngưỡng SLA (phút) trước khi watchdog nhắc lại dược sĩ (mặc định 60)
RELAY_SLA_MINUTES=60

# ── Alert / Observability (AR-8) ──
# Webhook URL nhận alert khi watchdog phát hiện ca SLA overdue.
# POST payload: { event, pharmacy_id, overdue_count, case_ids[] }
# Để trống = tắt alert (watchdog vẫn nhắc dược sĩ bình thường).
#ALERT_WEBHOOK_URL=
