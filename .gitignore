# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Diagnostic report files
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# node-gyp rebuild files
build/Release

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Environments and secrets (Chứa thông tin cấu hình nhạy cảm)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# Editor-specific directories and files (Cấu hình riêng của IDE/Editor)
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# Operating System files (File rác sinh ra bởi hệ điều hành)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Agent & tool-generated directories/files (Thư mục sinh ra từ AI Agent/MCP tools)
.agents/
.claude/
_bmad/
# Remotion video project (Dự án video Remotion)
videos/node_modules/
videos/out/
videos/.remotion/
videos/.esm-cache/
.claude/.story-automator-active

# ── MeCare per-tenant secrets & data volumes (Story 1.1, AC1/AC4) ──
# Chặn rõ mọi file env per-tenant; chỉ chừa _template.env (placeholder, committed).
tenants/*.env
!tenants/_template.env

# Data volumes nếu dùng bind-mount (named volume Docker không nằm trong repo)
baserow/data/
postgres/data/
openclaw/data/
# Phiên Zalo per-tenant (runtime) bị chặn; chừa .gitkeep để VCS giữ thư mục (NFR-6).
zalo-bridge/tenants/*
!zalo-bridge/tenants/.gitkeep

# .env.example là placeholder chung (committed) — chừa khỏi rule *.env.* ở trên
!.env.example
